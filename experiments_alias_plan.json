  "notes": {
    "exp6_lh4k_obp": "B1: LH table 4096 entries (2 KB), obp 16 KB.",
    "exp6_lh4k_noobp": "B1: LH table 4096 entries (2 KB), no obp. Pairs with lh4k_obp to give delta(4096). MUST differ from exp4_25in bit-for-bit.",
    "exp6_lh16k_obp": "B1: LH table 16384 entries (8 KB), obp 16 KB.",
    "exp6_lh16k_noobp": "B1: LH table 16384 entries (8 KB), no obp. Pairs with lh16k_obp to give delta(16384). MUST differ from lh4k_noobp.",
    "exp6_lh128k_obp": "B1: LH table 131072 entries (64 KB), obp 16 KB. Completes the delta curve at the top end.",
    "exp6_lh128k_noobp": "B1 DECISIVE: LH table 131072 entries (64 KB), no obp. Its bit0 IS the obp. delta(0) = this vs lh128k_obp. CRITERION 0: if this does not beat exp4_25in, aliasing is not the bottleneck and H4 dies.",
    "exp6_obp2k": "B2 JUDGE: obp table 2 KB (2^14), LH 1024. If it keeps >=70% of obp's gain, capacity is saturated => H4 loses, H4e (1-literal PC identity) wins.",
    "exp6_obp8k": "B2: obp table 8 KB (2^16), LH 1024.",
    "exp6_obp5_iso": "A: 5-bit per-PC history, no LH, 2^14 entries => 10 KB. Area-matched against the 16 KB obp table: capacity vs width.",
    "exp6_obp_zero": "SLOT CONTROL: 26 inputs, obp slot exists, but the bit handed to the TM is hard-wired to 0. Keeps the rand_01() sequence identical to exp4_26in, removes all information. Gives d_slot and d_info."
  },
